# Public site origin used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# off keeps the demonstration out of search indexes.
# Set to live only after sample records are replaced with real ones.
SITE_INDEXING=off

# Required before the editorial UI at /admin will accept a sign-in.
# Use a long random value. Do not reuse a password from another system.
CMS_EDITOR_PASSWORD=

# Required for editorial preview links. Use a different long random value.
CMS_PREVIEW_SECRET=

# Optional. When empty, staffing requests and applications run in test mode:
# they are stored privately on this server and are not delivered onward.
FORM_WEBHOOK_URL=

# Optional shared secret sent as Authorization: Bearer to FORM_WEBHOOK_URL.
FORM_WEBHOOK_TOKEN=
